# Configuração do Aura — Variáveis de Ambiente

# Ambiente de Execução (development | production)
NODE_ENV=development

# Porta do Servidor
PORT=3000
HOST=0.0.0.0

# Banco de Dados
# Para Desenvolvimento Local: SQLite (deixe em branco ou informe o caminho do arquivo)
SQLITE_PATH=./data/aura.db

# Para Produção na Hostinger VPS (Easypanel / PostgreSQL):
# Descomente e preencha com os dados do PostgreSQL gerado no Easypanel
# DATABASE_URL=postgresql://usuario:senha@postgres:5432/aura_db
